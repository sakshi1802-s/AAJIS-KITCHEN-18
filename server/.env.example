# ── Server environment ── copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

# MongoDB Atlas → Connect → Drivers. Include a database name, e.g. .../aji_kitchen?retryWrites=true&w=majority
MONGODB_URI=

# Where the client runs (exact origin, used for CORS)
CLIENT_ORIGIN=http://localhost:5173

# Long random string (≥ 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Aji's Google account email — the only account that gets role "owner".
# In dev you can put your own email here and use a second Google account as a customer.
OWNER_EMAIL=

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web)
GOOGLE_CLIENT_ID=

# Google AI Studio API key. Empty = "Plan my order" uses the deterministic fallback only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional — WhatsApp via n8n (roadmap section 7). Empty = notifications are a no-op.
N8N_WEBHOOK_URL=
N8N_SECRET=
