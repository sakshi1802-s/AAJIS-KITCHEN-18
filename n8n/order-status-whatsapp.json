      "typeVersion": 3,
      "position": [
        460,
        0
      ],
      "notes": "CANCELLED falls out of the switch: the customer already knows."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "11a",
              "name": "to",
              "type": "string",
              "value": "={{ (() => { const d = String($('Order status webhook').item.json.body.customerPhone || '').replace(/\\D/g, ''); const ten = d.slice(-10); return ten.length === 10 ? 'whatsapp:+91' + ten : ''; })() }}"
            },
            {
              "id": "11b",
              "name": "var1",
              "type": "string",
              "value": "=Order {{ $('Order status webhook').item.json.body.orderNumber }} CONFIRMED by Aji's Kitchen"
            },
            {
              "id": "11c",
              "name": "var2",
              "type": "string",
              "value": "={{ $('Order status webhook').item.json.body.items.map(i => i.name + ' x' + i.quantity + ' ₹' + (i.lineTotal / 100).toFixed(0)).join(', ') }} — total ₹{{ ($('Order status webhook').item.json.body.total / 100).toFixed(0) }}, for {{ $('Order status webhook').item.json.body.requestedFor.date }} ({{ $('Order status webhook').item.json.body.requestedFor.slot }})"
            }
          ]
        },
        "options": {}
      },
      "id": "aa000000-0000-4000-8000-000000000011",
      "name": "Accepted message",
