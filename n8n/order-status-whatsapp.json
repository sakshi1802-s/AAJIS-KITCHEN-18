{
  "name": "Aji's Kitchen — order status to WhatsApp",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "aji-order-status",
        "authentication": "headerAuth",
        "options": {}
      },
      "id": "f51f44ee-1f91-458a-97d9-b19ab4eda5ab",
      "name": "Order status webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -496,
        128
      ],
      "webhookId": "aji-order-status",
      "credentials": {
        "httpHeaderAuth": {
          "id": "xQfFEgdVf3NKiWnW",
          "name": "Header Auth account"
        }
      },
      "notes": "Guarded by Header Auth: x-webhook-secret must match the server's N8N_SECRET."
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 1
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.status }}",
                    "rightValue": "ACCEPTED",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "id": "fd0ec8b8-662b-4eab-afec-6f95dd925590"
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "accepted"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 1
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.status }}",
                    "rightValue": "DECLINED",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "id": "ea21ab5a-8c6a-41c4-85d2-ce29f5109b82"
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "declined"
            }
          ]
        },
        "options": {}
      },
      "id": "cca4ddee-1e02-4b9b-9470-181b6b588c3c",
      "name": "Which status?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        -256,
        128
      ],
      "notes": "CANCELLED falls out of the switch: the customer already knows."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "m1",
              "name": "to",
              "type": "string",
              "value": "=whatsapp:+91{{ $json.body.customerPhone }}"
            },
            {
              "id": "m2",
              "name": "message",
              "type": "string",
              "value": "=Namaskar {{ $json.body.customerName }}!\n\nAji has confirmed your order *{{ $json.body.orderNumber }}*\n\n*BILL*\n{{ $json.body.items.map(i => i.name + '  x' + i.quantity + '   ₹' + (i.lineTotal/100).toFixed(0)).join(String.fromCharCode(10)) }}\n------------------------------\n*Total   ₹{{ ($json.body.total / 100).toFixed(0) }}*\n\nDelivery: {{ $json.body.requestedFor.date }} ({{ $json.body.requestedFor.slot }})\nTo: {{ [$json.body.deliveryAddress.line1, $json.body.deliveryAddress.line2, $json.body.deliveryAddress.city, $json.body.deliveryAddress.pincode].filter(Boolean).join(', ') }}\n\nPay Aji directly on delivery. Dhanyavaad!"
            }
          ]
        },
        "options": {}
      },
      "id": "46025839-0fce-4978-a601-fc019c24408c",
      "name": "Accepted message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "d1",
              "name": "to",
              "type": "string",
              "value": "=whatsapp:+91{{ $json.body.customerPhone }}"
            },
            {
              "id": "d2",
              "name": "message",
              "type": "string",
              "value": "=Namaskar {{ $json.body.customerName }}, Aji can't take order *{{ $json.body.orderNumber }}* for {{ $json.body.requestedFor.date }}{{ $json.body.ownerNote ? ': ' + $json.body.ownerNote : '.' }}\n\nNothing has been charged. Do try another day."
            }
          ]
        },
        "options": {}
      },
      "id": "71febe37-6347-4fbd-ad58-13cc6636d5b4",
      "name": "Declined message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        0,
        224
      ]
    },
    {
      "parameters": {
        "from": "whatsapp:+17372508034",
        "to": "={{ $json.to }}",
        "toWhatsapp": true,
        "message": "={{ $json.message }}",
        "options": {}
      },
      "id": "de8fa011-eeb8-4ee4-a8c2-a8b32cb03a00",
      "name": "Send on WhatsApp",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [
        288,
        112
      ],
      "credentials": {
        "twilioApi": {
          "id": "TIsnsmV2NcRwWhx7",
          "name": "Twilio account"
        }
      },
      "notes": "Twilio sandbox number. Each recipient must send the join code once."
    }
  ],
  "connections": {
    "Order status webhook": {
      "main": [
        [
          {
            "node": "Which status?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Which status?": {
      "main": [
        [
          {
            "node": "Accepted message",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Declined message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Accepted message": {
      "main": [
        [
          {
            "node": "Send on WhatsApp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Declined message": {
      "main": [
        [
          {
            "node": "Send on WhatsApp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "binaryMode": "separate"
  }
}
