{
  "name": "Aaji's Kitchen — order status on WhatsApp",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "aji-order-status",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "11111111-1111-4111-8111-111111111111",
      "name": "Order status webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f0",
              "name": "status",
              "type": "string",
              "value": "={{ $json.body.status }}"
            },
            {
              "id": "f1",
              "name": "orderNumber",
              "type": "string",
              "value": "={{ $json.body.orderNumber }}"
            },
            {
              "id": "f2",
              "name": "customerName",
              "type": "string",
              "value": "={{ $json.body.customerName }}"
            },
            {
              "id": "f3",
              "name": "to",
              "type": "string",
              "value": "=whatsapp:+91{{ $json.body.customerPhone }}"
            },
            {
              "id": "f4",
              "name": "bill",
              "type": "string",
              "value": "={{ $json.body.items.map(i => i.name + ' × ' + i.quantity + ' — ₹' + (i.lineTotal / 100).toFixed(0)).join(String.fromCharCode(10)) }}"
            },
            {
              "id": "f5",
              "name": "total",
              "type": "string",
              "value": "={{ ($json.body.total / 100).toFixed(0) }}"
            },
            {
              "id": "f6",
              "name": "wantedDate",
              "type": "string",
              "value": "={{ $json.body.requestedFor.date }}"
            },
            {
              "id": "f7",
              "name": "wantedSlot",
              "type": "string",
              "value": "={{ $json.body.requestedFor.slot }}"
            },
            {
              "id": "f8",
              "name": "ownerNote",
              "type": "string",
              "value": "={{ $json.body.ownerNote || '' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "22222222-2222-4222-8222-222222222222",
      "name": "Read the order",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.status }}",
                    "rightValue": "ACCEPTED",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "confirmed"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.status }}",
                    "rightValue": "DECLINED",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "declined"
            }
          ]
        },
        "options": {}
      },
      "id": "33333333-3333-4333-8333-333333333333",
      "name": "Confirmed or declined?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f0",
              "name": "to",
              "type": "string",
              "value": "={{ $('Read the order').item.json.to }}"
            },
            {
              "id": "f1",
              "name": "message",
              "type": "string",
              "value": "=🧾 *AAJI'S KITCHEN*\nOrder #{{ $('Read the order').item.json.orderNumber }}\n\n{{ $('Read the order').item.json.bill }}\n------------------------------\n*Total: ₹{{ $('Read the order').item.json.total }}*\n\n📅 {{ $('Read the order').item.json.wantedDate }}\n🕐 {{ $('Read the order').item.json.wantedSlot }}\n\nYour order has been confirmed ❤️\nPay Aaji directly on delivery."
            }
          ]
        },
        "options": {}
      },
      "id": "44444444-4444-4444-8444-444444444444",
      "name": "Confirmation message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        680,
        200
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f0",
              "name": "to",
              "type": "string",
              "value": "={{ $('Read the order').item.json.to }}"
            },
            {
              "id": "f1",
              "name": "message",
              "type": "string",
              "value": "=🧾 *AAJI'S KITCHEN*\nOrder #{{ $('Read the order').item.json.orderNumber }}\n\nNamaskar {{ $('Read the order').item.json.customerName }}, Aaji can't take this one for {{ $('Read the order').item.json.wantedDate }}{{ $('Read the order').item.json.ownerNote ? ': ' + $('Read the order').item.json.ownerNote : '.' }}\n\n{{ $('Read the order').item.json.bill }}\n------------------------------\nTotal would have been ₹{{ $('Read the order').item.json.total }}\n\nNothing has been charged. Do try another day."
            }
          ]
        },
        "options": {}
      },
      "id": "55555555-5555-4555-8555-555555555555",
      "name": "Declined message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        680,
        420
      ]
    },
    {
      "parameters": {
        "resource": "sms",
        "operation": "send",
        "from": "whatsapp:+14155238886",
        "to": "={{ $json.to }}",
        "toWhatsapp": true,
        "message": "={{ $json.message }}",
        "options": {}
      },
      "id": "66666666-6666-4666-8666-666666666666",
      "name": "Send on WhatsApp",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [
        920,
        300
      ]
    }
  ],
  "connections": {
    "Order status webhook": {
      "main": [
        [
          {
            "node": "Read the order",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read the order": {
      "main": [
        [
          {
            "node": "Confirmed or declined?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Confirmed or declined?": {
      "main": [
        [
          {
            "node": "Confirmation message",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Declined message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Confirmation message": {
      "main": [
        [
          {
            "node": "Send on WhatsApp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Declined message": {
      "main": [
        [
          {
            "node": "Send on WhatsApp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
