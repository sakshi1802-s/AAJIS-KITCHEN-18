            {
              "name": "From",
              "value": "={{ $('Twilio settings').item.json.from }}"
            },
            {
              "name": "ContentSid",
              "value": "={{ $('Twilio settings').item.json.contentSid }}"
            },
            {
              "name": "ContentVariables",
              "value": "={{ JSON.stringify({ '1': $json.var1, '2': $json.var2 }) }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        }
