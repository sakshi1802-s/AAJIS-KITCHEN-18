# ── Client environment ── copy to .env. Everything here is PUBLIC (shipped to the browser).
# Never put secrets in a VITE_ variable.

# Leave empty: the client calls same-origin /api (Vite proxy in dev, Vercel rewrite in prod).
VITE_API_URL=

# Same OAuth client ID as the server's GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=

# Optional — Cloudinary unsigned upload preset for dish photos. Empty = paste an image URL instead.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
